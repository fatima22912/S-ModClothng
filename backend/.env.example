# ---- Base de données ---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smod_clothing
DB_USER=root
DB_PASSWORD=

# ---- JWT ------------------------------------------------------------------
# Générez une chaîne aléatoire longue en production (ex: openssl rand -hex 32)
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_TTL_SECONDS=86400

# ---- Front-end (CORS) -------------------------------------------------------
# Domaine(s) autorisé(s) à appeler l'API, séparés par une virgule
FRONTEND_URL=http://localhost:5173

# ---- Paiements ---------------------------------------------------------------
# S'Mod Clothing utilise un lien de paiement marchand Wave et un QR code
# marchand Orange Money (pas d'API programmatique avec webhook). Le
# paiement est confirmé manuellement par la propriétaire depuis son
# tableau de bord après vérification de la réception sur son compte.
WAVE_PAYMENT_LINK=https://pay.wave.com/m/M_sn_nSnCGLfVeL3K/c/sn/
ORANGE_MONEY_QR_IMAGE=/assets/paiement/orange-money-qr.jpg
